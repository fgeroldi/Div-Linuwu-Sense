#!/bin/sh
set -e

NAME="linuwu-sense"
MODULE="linuwu_sense"
VERSION="1.0"

case "$1" in
    remove|upgrade|deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop linuwu_sense.service >/dev/null 2>&1 || true
            systemctl disable linuwu_sense.service >/dev/null 2>&1 || true
        fi

        if command -v modprobe >/dev/null 2>&1; then
            modprobe -r "$MODULE" >/dev/null 2>&1 || true
        fi

        if command -v dkms >/dev/null 2>&1; then
            if [ -n "$(dkms status -m "$NAME" -v "$VERSION" 2>/dev/null)" ]; then
                dkms remove -m "$NAME" -v "$VERSION" --all >/dev/null 2>&1 || true
            fi
        fi
    ;;
esac

exit 0
